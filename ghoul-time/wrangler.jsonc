{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ghoul-time",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  },
  "workers_dev": false,
  "routes": [
    { "pattern": "ghoultime.ipgoblin.com", "custom_domain": true }
  ],
  "dev": {
    "port": 8787,
    "ip": "127.0.0.1"
  },
  "observability": {
    "enabled": true
  }
}
