{
  "name": "ipgoblin-scores",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "High score tables for the goblin arcade, served from scores.ipgoblin.com",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "test": "node --test test/*.test.js",
    "migrate:local": "wrangler d1 migrations apply ipgoblin-scores --local",
    "migrate:remote": "wrangler d1 migrations apply ipgoblin-scores --remote"
  },
  "devDependencies": {
    "wrangler": "^4.127.1"
  }
}
